# Copy to .env and adjust. All values are optional except the admin password.

# Password for /admin (the admin page is disabled while this is empty).
MSD_ADMIN_PASSWORD=change-me

# Host port for the website.
MSD_PORT=8080

# URL path the site is served under, when a reverse proxy puts it below the
# site root (e.g. /sofa/ for https://host/sofa/). The proxy strips the prefix;
# this tells the pages and cookies where they live. Default: /
#MSD_BASE_PATH=/

# How simulations run: native (one process each, using ./runtime; run.sh) or
# docker (one container each; run-docker.sh sets this for you).
#MSD_BACKEND=native

# Defaults for the limits below; they can also be changed live on the admin
# page (those changes are stored in the data volume and take precedence).
MSD_MAX_SIMS=3
MSD_IDLE_TIMEOUT_MINUTES=15
MSD_MAX_HOLD_HOURS=12
MSD_MAX_HELD_SIMS=1
# Per client IP; 0 = unlimited. NOTE: behind a reverse proxy set
# MSD_TRUST_PROXY_HEADERS=true; on Docker Desktop all visitors share one
# gateway IP, so use 0 there (see README, Deployment notes).
MSD_MAX_CLAIMS_PER_CLIENT=1

# Resource caps per simulation (a scene.json can override them).
MSD_SIM_CPUS=1.0
MSD_SIM_MEMORY=2g
MSD_START_TIMEOUT_SECONDS=120

# Set to true when running behind a reverse proxy (nginx, Caddy, Traefik...)
# that sets X-Forwarded-For / X-Forwarded-Proto.
MSD_TRUST_PROXY_HEADERS=false

# Native backend: runtime location (defaults to ./runtime), cgroup caps: auto | off
#MSD_RUNTIME_DIR=
#MSD_USE_CGROUPS=auto
